# PostgreSQL runtime URL. En Vercel usa una URL con pooling cuando tu proveedor la ofrezca.
DATABASE_URL=postgresql://user:password@host:5432/rinconcito_del_sabor?sslmode=require

# URL directa recomendada para Prisma Migrate. Si tu proveedor no distingue pooled/direct, usa la misma.
DIRECT_URL=postgresql://user:password@host:5432/rinconcito_del_sabor?sslmode=require

# Opcional en Vercel: si no se define, la app usa VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL.
APP_URL=https://tu-dominio.com

# Mínimo 32 caracteres. Genera un valor aleatorio exclusivo por entorno.
SESSION_SECRET=replace-with-at-least-32-random-characters

# Se conserva por compatibilidad con configuración existente.
AUTH_SECRET=replace-with-at-least-32-random-characters

BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Rinconcito del Sabor

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

NEXT_PUBLIC_APP_NAME=Rinconcito del Sabor
# Opcional. Si queda vacío, los QR usan window.location.origin.
NEXT_PUBLIC_APP_URL=https://tu-dominio.com

# Preview deployments NO ejecutan migraciones por defecto.
# Configura 1 solo si la preview usa una base separada preparada para migraciones.
VERCEL_RUN_MIGRATIONS=0

# Solo para seed local. Nunca definir estas variables en producción.
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=
