generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED
  LOCKED
}

enum TableStatus {
  FREE
  RESERVED
  WAITING_ORDER
  OCCUPIED
  SENT
  PREPARING
  PARTIALLY_READY
  READY
  WAITING_DELIVERY
  WAITING_BILL
  PENDING_PAYMENT
  TO_CLEAN
  BLOCKED
}

enum TableSessionStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum OrderStatus {
  NEW
  CONFIRMED
  SENT
  RECEIVED
  PREPARING
  PARTIALLY_READY
  READY
  DELIVERED
  PENDING_PAYMENT
  PAID
  CANCELLED
  VOIDED
}

enum OrderItemStatus {
  PENDING
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

enum OrderPriority {
  NORMAL
  PRIORITY
  RUSH
  CHILD
  DELIVERY
  PICKUP
  REMAKE
}

enum TicketStatus {
  NEW
  PREPARING
  PARTIALLY_READY
  READY
  DELIVERED
  CANCELLED
}

enum ProductType {
  DISH
  BEVERAGE
  COMBO
  EXTRA
}

enum ProductAvailability {
  AVAILABLE
  LOW_STOCK
  SOLD_OUT
  TEMPORARILY_UNAVAILABLE
}

enum InventoryMovementType {
  PURCHASE
  SALE
  RECIPE_CONSUMPTION
  RETURN
  ADJUSTMENT
  LOSS
  DAMAGE
  EXPIRATION
  INTERNAL_USE
  CANCELLATION
  INITIAL_STOCK
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  SALE
  INCOME
  TIP
  EXPENSE
  WITHDRAWAL
  DEPOSIT
  REFUND
  ADJUSTMENT
}

enum PaymentMethod {
  CASH
  YAPE
  PLIN
  CARD
  TRANSFER
  CREDIT
  OTHER
}

enum PaymentStatus {
  COMPLETED
  VOIDED
  REFUNDED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  ARRIVED
  CANCELLED
  NO_SHOW
}

enum DeliveryStatus {
  RECEIVED
  CONFIRMED
  PREPARING
  READY
  ON_THE_WAY
  DELIVERED
  CANCELLED
}

enum NotificationLevel {
  INFO
  IMPORTANT
  CRITICAL
}

enum DocumentType {
  PRECHECK
  RECEIPT
  INVOICE
  CREDIT_NOTE
  DEBIT_NOTE
}

enum DocumentStatus {
  PENDING
  GENERATED
  SENDING
  ACCEPTED
  REJECTED
  OBSERVED
  VOIDED
  ERROR
  PENDING_SEND
}

model User {
  id                  String      @id @default(cuid())
  email               String      @unique
  passwordHash        String
  firstName           String
  lastName            String
  avatarUrl           String?
  status              UserStatus  @default(ACTIVE)
  failedLogins        Int         @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  deletedAt           DateTime?
  roles               UserRole[]
  sessions            Session[]
  auditLogs           AuditLog[]
  orders              Order[]     @relation("WaiterOrders")
  tableSessions       TableSession[] @relation("WaiterTableSessions")
  cashSessions        CashSession[]
  notifications       Notification[]
  statusChanges       OrderStatusHistory[]
  passwordResetTokens PasswordResetToken[]
  @@index([status])
}

model Role {
  id String @id @default(cuid())
  name String @unique
  description String?
  system Boolean @default(false)
  users UserRole[]
  permissions RolePermission[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Permission {
  id String @id @default(cuid())
  code String @unique
  description String?
  roles RolePermission[]
  createdAt DateTime @default(now())
}

model UserRole {
  userId String
  roleId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@id([userId, roleId])
}

model RolePermission {
  roleId String
  permissionId String
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
}

model Session {
  id String @id @default(cuid())
  tokenHash String @unique
  userId String
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip String?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id String @id @default(cuid())
  userId String
  tokenHash String @unique
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model RestaurantSettings {
  id String @id @default("singleton")
  legalName String
  tradeName String
  ruc String?
  address String?
  phone String?
  email String?
  logoUrl String?
  currency String @default("PEN")
  timezone String @default("America/Lima")
  igvRate Decimal @default(18) @db.Decimal(5, 2)
  pricesIncludeTax Boolean @default(true)
  soundEnabled Boolean @default(true)
  qrOrderingEnabled Boolean @default(false)
  waiterApprovalRequired Boolean @default(true)
  updatedAt DateTime @updatedAt
}

model Zone {
  id String @id @default(cuid())
  name String @unique
  sortOrder Int @default(0)
  active Boolean @default(true)
  tables RestaurantTable[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RestaurantTable {
  id String @id @default(cuid())
  number Int @unique
  name String?
  capacity Int
  status TableStatus @default(FREE)
  active Boolean @default(true)
  zoneId String
  version Int @default(1)
  zone Zone @relation(fields: [zoneId], references: [id])
  orders Order[]
  tableSessions TableSession[]
  reservations Reservation[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([zoneId, status, active])
}

model TableSession {
  id String @id @default(cuid())
  tableId String
  waiterId String?
  guestCount Int @default(1)
  status TableSessionStatus @default(OPEN)
  openedAt DateTime @default(now())
  closedAt DateTime?
  table RestaurantTable @relation(fields: [tableId], references: [id])
  waiter User? @relation("WaiterTableSessions", fields: [waiterId], references: [id])
  orders Order[]
  @@index([tableId, status])
}

model Station {
  id String @id @default(cuid())
  name String @unique
  color String @default("#f97316")
  active Boolean @default(true)
  products Product[]
  tickets KitchenTicket[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id String @id @default(cuid())
  name String @unique
  icon String?
  imageUrl String?
  imagePublicId String?
  sortOrder Int @default(0)
  active Boolean @default(true)
  products Product[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id String @id @default(cuid())
  name String
  slug String @unique
  shortName String?
  description String?
  type ProductType @default(DISH)
  price Decimal @db.Decimal(12, 2)
  cost Decimal @default(0) @db.Decimal(12, 2)
  estimatedMinutes Int?
  imageUrl String?
  imagePublicId String?
  active Boolean @default(true)
  availability ProductAvailability @default(AVAILABLE)
  stockPortions Int?
  featured Boolean @default(false)
  categoryId String
  stationId String?
  category Category @relation(fields: [categoryId], references: [id])
  station Station? @relation(fields: [stationId], references: [id])
  recipeItems RecipeItem[]
  variants ProductVariant[]
  addons ProductAddon[]
  orderItems OrderItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  @@index([categoryId, availability, active])
  @@index([stationId])
}

model ProductVariant {
  id String @id @default(cuid())
  productId String
  groupName String
  name String
  priceDelta Decimal @default(0) @db.Decimal(12, 2)
  active Boolean @default(true)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@unique([productId, groupName, name])
  @@index([productId, groupName])
}

model ProductAddon {
  id String @id @default(cuid())
  productId String
  name String
  price Decimal @default(0) @db.Decimal(12, 2)
  active Boolean @default(true)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@unique([productId, name])
  @@index([productId])
}

model Ingredient {
  id String @id @default(cuid())
  name String @unique
  unit String
  stock Decimal @default(0) @db.Decimal(14, 3)
  minStock Decimal? @db.Decimal(14, 3)
  maxStock Decimal? @db.Decimal(14, 3)
  averageCost Decimal @default(0) @db.Decimal(14, 4)
  active Boolean @default(true)
  recipeItems RecipeItem[]
  movements InventoryMovement[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([active, stock])
}

model RecipeItem {
  productId String
  ingredientId String
  quantity Decimal @db.Decimal(14, 3)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])
  @@id([productId, ingredientId])
}

model Order {
  id String @id @default(cuid())
  number Int @unique @default(autoincrement())
  idempotencyKey String @unique
  type OrderType
  status OrderStatus @default(NEW)
  priority OrderPriority @default(NORMAL)
  tableId String?
  tableSessionId String?
  waiterId String?
  customerName String?
  customerPhone String?
  deliveryAddress String?
  deliveryReference String?
  notes String?
  guestCount Int @default(1)
  subtotal Decimal @default(0) @db.Decimal(12, 2)
  discount Decimal @default(0) @db.Decimal(12, 2)
  tax Decimal @default(0) @db.Decimal(12, 2)
  total Decimal @default(0) @db.Decimal(12, 2)
  version Int @default(1)
  openedAt DateTime @default(now())
  confirmedAt DateTime?
  sentAt DateTime?
  receivedAt DateTime?
  startedAt DateTime?
  readyAt DateTime?
  deliveredAt DateTime?
  requestedBillAt DateTime?
  paidAt DateTime?
  cancelledAt DateTime?
  table RestaurantTable? @relation(fields: [tableId], references: [id])
  tableSession TableSession? @relation(fields: [tableSessionId], references: [id])
  waiter User? @relation("WaiterOrders", fields: [waiterId], references: [id])
  items OrderItem[]
  tickets KitchenTicket[]
  statusHistory OrderStatusHistory[]
  sale Sale?
  delivery DeliveryOrder?
  notifications Notification[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, openedAt])
  @@index([tableId, status])
  @@index([type, status])
}

model OrderItem {
  id String @id @default(cuid())
  orderId String
  productId String
  productName String
  quantity Int
  unitPrice Decimal @db.Decimal(12, 2)
  discount Decimal @default(0) @db.Decimal(12, 2)
  notes String?
  status OrderItemStatus @default(PENDING)
  total Decimal @db.Decimal(12, 2)
  startedAt DateTime?
  readyAt DateTime?
  deliveredAt DateTime?
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  modifiers OrderItemModifier[]
  createdAt DateTime @default(now())
  @@index([orderId, status])
  @@index([productId])
}

model OrderItemModifier {
  id String @id @default(cuid())
  orderItemId String
  name String
  priceDelta Decimal @default(0) @db.Decimal(12, 2)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  @@index([orderItemId])
}

model OrderStatusHistory {
  id String @id @default(cuid())
  orderId String
  actorId String?
  fromStatus OrderStatus?
  toStatus OrderStatus
  device String?
  createdAt DateTime @default(now())
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id])
  @@index([orderId, createdAt])
}

model KitchenTicket {
  id String @id @default(cuid())
  orderId String
  stationId String
  status TicketStatus @default(NEW)
  sentAt DateTime @default(now())
  startedAt DateTime?
  readyAt DateTime?
  deliveredAt DateTime?
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  station Station @relation(fields: [stationId], references: [id])
  @@unique([orderId, stationId])
  @@index([stationId, status, sentAt])
}

model InventoryMovement {
  id String @id @default(cuid())
  ingredientId String
  idempotencyKey String? @unique
  type InventoryMovementType
  quantity Decimal @db.Decimal(14, 3)
  unitCost Decimal? @db.Decimal(14, 4)
  balanceAfter Decimal @db.Decimal(14, 3)
  reference String?
  reason String?
  createdAt DateTime @default(now())
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])
  @@index([ingredientId, createdAt])
}

model Sale {
  id String @id @default(cuid())
  orderId String @unique
  subtotal Decimal @db.Decimal(12, 2)
  discount Decimal @default(0) @db.Decimal(12, 2)
  tax Decimal @db.Decimal(12, 2)
  total Decimal @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  cancelledAt DateTime?
  order Order @relation(fields: [orderId], references: [id])
  payments Payment[]
  documents FiscalDocument[]
}

model Payment {
  id String @id @default(cuid())
  idempotencyKey String @unique
  saleId String
  cashSessionId String?
  method PaymentMethod
  status PaymentStatus @default(COMPLETED)
  amount Decimal @db.Decimal(12, 2)
  receivedAmount Decimal? @db.Decimal(12, 2)
  changeAmount Decimal? @db.Decimal(12, 2)
  reference String?
  createdAt DateTime @default(now())
  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  cashSession CashSession? @relation(fields: [cashSessionId], references: [id])
  @@index([saleId])
  @@index([cashSessionId, createdAt])
}

model CashRegister {
  id String @id @default(cuid())
  name String @unique
  active Boolean @default(true)
  sessions CashSession[]
}

model CashSession {
  id String @id @default(cuid())
  registerId String
  userId String
  idempotencyKey String @unique
  status CashSessionStatus @default(OPEN)
  openingAmount Decimal @db.Decimal(12, 2)
  expectedCash Decimal? @db.Decimal(12, 2)
  countedCash Decimal? @db.Decimal(12, 2)
  difference Decimal? @db.Decimal(12, 2)
  openedAt DateTime @default(now())
  closedAt DateTime?
  register CashRegister @relation(fields: [registerId], references: [id])
  user User @relation(fields: [userId], references: [id])
  movements CashMovement[]
  payments Payment[]
  @@index([registerId, status])
  @@index([userId, status])
}

model CashMovement {
  id String @id @default(cuid())
  sessionId String
  idempotencyKey String? @unique
  type CashMovementType
  amount Decimal @db.Decimal(12, 2)
  reason String?
  reference String?
  createdAt DateTime @default(now())
  session CashSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  @@index([sessionId, createdAt])
}

model Customer {
  id String @id @default(cuid())
  name String
  phone String? @unique
  email String?
  notes String?
  reservations Reservation[]
  deliveries DeliveryOrder[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Reservation {
  id String @id @default(cuid())
  customerId String?
  tableId String?
  customerName String
  phone String
  partySize Int
  reservedFor DateTime
  status ReservationStatus @default(PENDING)
  notes String?
  customer Customer? @relation(fields: [customerId], references: [id])
  table RestaurantTable? @relation(fields: [tableId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([reservedFor, status])
}

model DeliveryOrder {
  id String @id @default(cuid())
  orderId String @unique
  customerId String?
  status DeliveryStatus @default(RECEIVED)
  courierName String?
  estimatedAt DateTime?
  deliveredAt DateTime?
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, createdAt])
}

model Promotion {
  id String @id @default(cuid())
  name String
  description String?
  discountPercent Decimal? @db.Decimal(5, 2)
  specialPrice Decimal? @db.Decimal(12, 2)
  startsAt DateTime
  endsAt DateTime
  daysOfWeek Int[]
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([active, startsAt, endsAt])
}

model Notification {
  id String @id @default(cuid())
  userId String?
  orderId String?
  title String
  message String
  level NotificationLevel @default(INFO)
  readAt DateTime?
  createdAt DateTime @default(now())
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id], onDelete: Cascade)
  @@index([userId, readAt, createdAt])
}

model FiscalDocument {
  id String @id @default(cuid())
  saleId String
  type DocumentType
  status DocumentStatus @default(PENDING)
  series String?
  correlativo Int?
  xml String?
  response String?
  error String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sale Sale @relation(fields: [saleId], references: [id])
  @@unique([type, series, correlativo])
  @@index([status, createdAt])
}

model AuditLog {
  id String @id @default(cuid())
  userId String?
  action String
  module String
  entity String?
  entityId String?
  before Json?
  after Json?
  metadata Json?
  ip String?
  userAgent String?
  createdAt DateTime @default(now())
  user User? @relation(fields: [userId], references: [id])
  @@index([module, createdAt])
  @@index([entity, entityId])
  @@index([userId, createdAt])
}

model IdempotencyOperation {
  id String @id @default(cuid())
  scope String
  key String
  resultId String?
  createdAt DateTime @default(now())
  expiresAt DateTime
  @@unique([scope, key])
  @@index([expiresAt])
}
